# App mode
ENVIRONMENT=development
DEBUG=false
API_DOCS_ENABLED=true
SECURITY_HEADERS_ENABLED=true

# Network and browser access
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///./susu_books.db
DB_ECHO=false

# Local Gemma 4 via Ollama
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-instruct
OLLAMA_TIMEOUT=300

# Hosted Google Gemini API / Gemma 4 alternative
# Get a key from Google AI Studio, then switch AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT=120

# API safeguards
EXPORT_MAX_ROWS=5000
CHAT_RATE_LIMIT_REQUESTS=60
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
